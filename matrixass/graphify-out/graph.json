    },
    {
      "label": "Benchmark Text Output Format",
      "file_type": "concept",
      "source_file": "COSC3500_Assignment.pdf",
      "source_location": "page 2",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "GradeBot writes stdout plus one text file per benchmark per node, named COSC3500Assignment_{benchmark type}_{node}.txt, with 6 columns: Info ({CPU|GPU|MPI}, [mpiRank,mpiWorldSize], {threadCount|gpuID|mpiRank}, {physical core count|GPU count|mpiWorldSize}, hardware name), N (matrix dimension), Matrices/second (MKL reference), Matrices/second (You), Error (sum of squares difference vs reference), Grade (marks assigned).",
