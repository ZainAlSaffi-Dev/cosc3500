    },
    {
      "label": "Modifiable Files Constraint",
      "file_type": "rationale",
      "source_file": "COSC3500_Assignment.pdf",
      "source_location": "page 1",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Only 3 files may be changed for final submission: matrixMultiply.cpp, matrixMultiplyGPU.cu, matrixMultiplyMPI.cpp. Functions may not use any header files or outside libraries other than the provided headers (matrixMultiply.h, matrixMultiplyGPU.cuh, matrixMultiplyMPI.h), and must not write to stdout or to file in the final submission. This keeps the automated benchmark/marking harness in control of I/O and dependencies.",
      "id": "cosc3500_assignment_modifiable_files_constraint",
      "community": 1,
      "norm_label": "modifiable files constraint"
    },
