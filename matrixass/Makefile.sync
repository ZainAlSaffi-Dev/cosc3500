# Local workflow helpers for the matrixass assignment. The assignment's own
# Makefile only builds on rangpur, this one runs on the Mac.
# Usage: make -f Makefile.sync push | run-<script> | queue | fetch | judgement

REMOTE_DIR = cosc3500/matrixass
SLURM_BIN = /opt/slurm/bin

.PHONY: help push queue fetch judgement

help:
	@echo "push            rsync the working tree to rangpur:$(REMOTE_DIR) (never .env)"
	@echo "run-<script>    sbatch slurm/<script> on rangpur, e.g. run-bench_cpu_2048.sh"
	@echo "queue           show the rangpur job queue for this user"
	@echo "fetch           pull slurm-*.out and GradeBot txt files into results/rangpur/"
	@echo "judgement       submit the pinned JudgementDay script (budgeted, Phases 7-8 only)"

# --delete keeps the remote tree honest but never touches excluded paths
# (rsync only deletes excluded files with --delete-excluded, which we do not use),
# so remote job outputs and build artifacts survive each push.
push:
	rsync -az --delete \
		--exclude '.git' \
		--exclude '.env' \
		--exclude '.DS_Store' \
		--exclude 'graphify-out' \
		--exclude 'docs' \
		--exclude 'results' \
		--exclude 'slurm-*.out' \
		--exclude 'COSC3500Assignment_*.txt' \
		--exclude '*.o' \
		--exclude 'Assignment1_GradeBot' \
		./ rangpur:$(REMOTE_DIR)/

# sbatch lives in /opt/slurm/bin, which non-interactive ssh shells do not have
# on PATH, hence the export in every remote command.
run-%:
	ssh rangpur 'export PATH=$(SLURM_BIN):$$PATH; cd $(REMOTE_DIR) && sbatch slurm/$*'

queue:
	ssh rangpur 'export PATH=$(SLURM_BIN):$$PATH; squeue -u $$USER'

fetch:
	mkdir -p results/rangpur
	rsync -az 'rangpur:$(REMOTE_DIR)/slurm-*.out' results/rangpur/ || true
	rsync -az 'rangpur:$(REMOTE_DIR)/COSC3500Assignment_*.txt' results/rangpur/ || true

judgement:
	@echo "JudgementDay is pinned to a100-a/a100-b and shared by the whole course."
	@echo "Budget is a few runs total, Phases 7 and 8 only. Ctrl-C now to abort."
	@sleep 5
	ssh rangpur 'export PATH=$(SLURM_BIN):$$PATH; cd $(REMOTE_DIR) && sbatch slurm/goslurm_COSC3500Assignment_RangpurJudgementDay'
